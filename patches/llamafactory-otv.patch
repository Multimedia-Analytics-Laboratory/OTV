+class SequenceRegressionHead(nn.Module):
+    def __init__(
+        self,
+        input_dim: int,
+        hidden_dims: list[int] | tuple[int, ...] | int = (1024, 256),
+        dropout: float = 0.2,
+    ) -> None:
+        super().__init__()
+        if isinstance(hidden_dims, int):
+            hidden_dims = [hidden_dims, 256]
+        hidden_dims = [int(dim) for dim in hidden_dims if int(dim) > 0]
+        if not hidden_dims:
+            raise ValueError("SequenceRegressionHead requires at least one hidden dimension.")
+
+        self.input_dim = int(input_dim)
+        self.hidden_dims = hidden_dims
+        self.dropout = float(dropout)
+
+        dims = [self.input_dim] + self.hidden_dims
+        self.layers = nn.ModuleList(
+            [nn.Linear(dims[idx], dims[idx + 1]) for idx in range(len(dims) - 1)]
+        )
+        self.dropouts = nn.ModuleList([nn.Dropout(self.dropout) for _ in self.hidden_dims])
+        self.activation = nn.ReLU()
+        self.output_layer = nn.Linear(self.hidden_dims[-1], 1)
+        self.sigmoid = nn.Sigmoid()
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        hidden_states = hidden_states.to(self.layers[0].weight.dtype)
+        for layer, dropout in zip(self.layers, self.dropouts):
+            hidden_states = layer(hidden_states)
+            hidden_states = self.activation(hidden_states)
+            hidden_states = dropout(hidden_states)
+
+        hidden_states = self.output_layer(hidden_states)
+        return self.sigmoid(hidden_states)
+
+    def to_config(self) -> dict[str, object]:
+        return {
+            "input_dim": self.input_dim,
+            "hidden_dims": list(self.hidden_dims),
+            "dropout": self.dropout,
+        }
+
+
+def _parse_hidden_dims(raw_value: str | list[int] | tuple[int, ...] | None) -> list[int]:
+    if raw_value is None:
+        return [1024, 256]
+    if isinstance(raw_value, str) and not raw_value.strip():
+        return [1024, 256]
+    if isinstance(raw_value, (list, tuple)):
+        dims = [int(item) for item in raw_value if int(item) > 0]
+    else:
+        dims = [int(item.strip()) for item in str(raw_value).split(",") if item.strip()]
+    if not dims:
+        raise ValueError(f"Invalid regression hidden dims: {raw_value}")
+    return dims
+
+
+def _regression_config_path_from_regression_path(regression_path: str | None) -> str | None:
+    if regression_path is None:
+        return None
+    return os.path.join(os.path.dirname(regression_path), OTV_REGRESSION_CONFIG_FILENAME)
+
+
+def _load_regression_head_config(input_dim: int, regression_path: str | None = None) -> dict[str, object]:
+    config_path = _regression_config_path_from_regression_path(regression_path)
+    if config_path is not None and os.path.isfile(config_path):
+        with open(config_path, "r", encoding="utf-8") as handle:
+            payload = json.load(handle)
+        return {
+            "input_dim": int(payload.get("input_dim", input_dim)),
+            "hidden_dims": _parse_hidden_dims(payload.get("hidden_dims", [1024, 256])),
+            "dropout": float(payload.get("dropout", 0.2)),
+        }
+
+    raw_dropout = os.getenv(OTV_REG_DROPOUT_ENV)
+    if raw_dropout is None or not raw_dropout.strip():
+        raw_dropout = "0.2"
+    return {
+        "input_dim": int(input_dim),
+        "hidden_dims": _parse_hidden_dims(os.getenv(OTV_REG_HIDDEN_DIMS_ENV)),
+        "dropout": float(raw_dropout),
+    }
+
+
+def _build_regression_head(input_dim: int, regression_path: str | None = None) -> SequenceRegressionHead:
+    config = _load_regression_head_config(input_dim=input_dim, regression_path=regression_path)
+    return SequenceRegressionHead(
+        input_dim=int(config["input_dim"]),
+        hidden_dims=config["hidden_dims"],
+        dropout=float(config["dropout"]),
+    )
+
+
+def _regression_head_matches(model: "PreTrainedModel", regression_path: str | None = None) -> bool:
+    if not hasattr(model, "regression_head") or not isinstance(model.regression_head, SequenceRegressionHead):
+        return False
+    config = _load_regression_head_config(input_dim=_get_hidden_size(model.config), regression_path=regression_path)
+    return (
+        int(config["input_dim"]) == model.regression_head.input_dim
+        and list(config["hidden_dims"]) == list(model.regression_head.hidden_dims)
+        and abs(float(config["dropout"]) - float(model.regression_head.dropout)) < 1e-8
+    )
+
+
+def _is_truthy_env(value: str | None) -> bool:
+    if value is None:
+        return False
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _normalize_adapter_paths(adapter_name_or_path):
+    if adapter_name_or_path is None:
+        return []
+    if isinstance(adapter_name_or_path, str):
+        return [item.strip() for item in adapter_name_or_path.split(",") if item.strip()]
+    return [item for item in adapter_name_or_path if item]
+
+
+def _find_otv_regression_path(adapter_name_or_path) -> str | None:
+    for adapter_path in reversed(_normalize_adapter_paths(adapter_name_or_path)):
+        regression_path = os.path.join(adapter_path, OTV_REGRESSION_FILENAME)
+        if os.path.isfile(regression_path):
+            return regression_path
+    return None
+
+
+def _get_hidden_size(config: "PretrainedConfig") -> int:
+    hidden_size = getattr(config, "hidden_size", None)
+    if hidden_size is None and hasattr(config, "text_config"):
+        hidden_size = getattr(config.text_config, "hidden_size", None)
+
+    if hidden_size is None:
+        raise ValueError("Cannot infer hidden size for OTV regression head.")
+
+    return hidden_size
+
+
+def _get_first_attention_module(model: "PreTrainedModel") -> nn.Module:
+    backbone = getattr(model, "base_model", None)
+    backbone = getattr(backbone, "model", model)
+    transformer = getattr(backbone, "model", backbone)
+    layers = getattr(transformer, "layers", None)
+    if not layers:
+        raise ValueError("Cannot locate transformer layers for OTV attention override.")
+
+    return layers[0].self_attn
+
+
+def _load_regression_head(model: "PreTrainedModel", regression_path: str) -> None:
+    state_dict = {}
+    with safe_open(regression_path, framework="pt", device="cpu") as handle:
+        for key in handle.keys():
+            state_dict[key] = handle.get_tensor(key)
+
+    if all(key.startswith("regression_head.") for key in state_dict):
+        state_dict = {key.replace("regression_head.", "", 1): value for key, value in state_dict.items()}
+
+    missing_keys, unexpected_keys = model.regression_head.load_state_dict(state_dict, strict=False)
+    if missing_keys or unexpected_keys:
+        logger.warning_rank0(
+            "Loaded OTV regression head with missing keys {} and unexpected keys {}.".format(
+                list(missing_keys), list(unexpected_keys)
+            )
+        )
+
+
+def _attach_otv_modules(model: "PreTrainedModel", regression_path: str | None = None) -> "PreTrainedModel":
+    if not hasattr(model, "regression_head") or not _regression_head_matches(model, regression_path):
+        model.regression_head = _build_regression_head(
+            input_dim=_get_hidden_size(model.config),
+            regression_path=regression_path,
+        )
+
+    if not hasattr(model, "origin_forward"):
+        model.origin_forward = type(_get_first_attention_module(model)).forward
+
+    if regression_path is not None:
+        logger.info_rank0(f"Loading OTV regression head from {regression_path}.")
+        _load_regression_head(model, regression_path)
+
+    return model
+
+
